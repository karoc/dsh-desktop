{
  "name": "@dsh-desktop/client-notifications",
  "version": "0.1.0",
  "description": "DSH Smoothly Desktop notification client plugin: OS notifications when dsh asks you something (pendingInteraction) or a session finishes (running true→false).",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.6-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-workspace": {
      "optional": true
    }
  }
}