{
  "name": "dsh-turn-navigator",
  "version": "0.4.3",
  "description": "Smoothly Turn Nav (Smoothly TN): full-history piano-key turn rail for DeepSeek Harness (dsh) web conversations — see every turn at a glance, hover to preview, click to jump anywhere, and replace the official (non-disableable) turn rail.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "docs/turn-nav-rail.png",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-web-react",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown --config ./tsdown.config.ts",
    "prepare": "tsdown --config ./tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "release:check": "node scripts/release-check.mjs",
    "prepack": "node scripts/release-check.mjs",
    "prepublishOnly": "node scripts/release-check.mjs && tsdown --config ./tsdown.config.ts",
    "postpublish": "node scripts/post-publish-check.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "turn",
    "navigation",
    "conversation",
    "outline",
    "turn-rail",
    "turn-navigator",
    "smoothly",
    "思磨力",
    "smoothly-turn-nav",
    "smoothly-tn"
  ],
  "author": "karoc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karoc/dsh-turn-nav.git"
  },
  "bugs": {
    "url": "https://github.com/karoc/dsh-turn-nav/issues"
  },
  "homepage": "https://github.com/karoc/dsh-turn-nav",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^19.2.4",
    "react": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
