{
  "identifier": "remote-notifications",
  "description": "The loopback dsh UI may raise OS notifications only. No file/system/network IPC is exposed.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1/*"]
  },
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:allow-unlisten",
    "notification:allow-notify"
  ]
}