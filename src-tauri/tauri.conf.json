{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.3.5",
  "identifier": "dev.dsh.desktop",
  "build": {
    "beforeBuildCommand": "node scripts/fetch-node.mjs && node scripts/sync-resources.mjs",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DSH Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "url": "index.html",
        "backgroundColor": "#0d1117"
      }
    ],
    "security": {
      "capabilities": [
        "launcher",
        "remote-notifications"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/node",
      "resources/manager",
      "resources/patch",
      "resources/plugin",
      "resources/preinstalled"
    ],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop shell",
    "longDescription": "A standalone Tauri shell for DeepSeek Harness (dsh): auto-updates the official dsh npm package, embeds a Node.js 24 runtime, and surfaces OS notifications for questions and completions.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "build-essential",
          "python3"
        ]
      }
    }
  }
}
